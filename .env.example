# Copy to .env and fill in. Never commit .env.
# OmniRoute auth requires a real client API key from the OmniRoute dashboard /
# api_keys store — "local-omniroute" is rejected (docs/omniroute-contract.md §1).
OMNIROUTE_API_KEY=replace-with-real-omniroute-client-api-key
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=auto/deepseek

DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
